# Signs login cookies. At least 32 characters. Make one with: openssl rand -hex 32
JWT_SECRET=

# The app's public address, with no slash at the end. Used for social login.
APP_URL=http://localhost:3000

# Social login (optional). Leave a pair empty to keep that button switched off.
# Callback URL to register: APP_URL/api/auth/oauth/google/callback (or x, facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
